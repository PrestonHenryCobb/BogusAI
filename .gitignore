__pycache__/
*.pyc
.venv/
venv/
.env

# processed/derived data stays out; the raw EMSCAD csv is committed so the pipeline runs as cloned (see README for attribution)
data/processed/*.csv
!data/processed/.gitkeep

# raw third-party downloads and caches (LinkedIn postings, Reddit text); rebuild with
# the commands in docs/REALWORLD_DATA.md. Only IDs, labels and splits are committed
# under data/realworld/.
data/external/

# model artifacts: the demo model and the two the comparisons use are committed so the
# whole team runs the same ones without retraining (5 MB each). Everything else in
# models/ (other tiers, reports) stays local; regenerate with `python -m src.model.train`.
models/*
!models/model.joblib
!models/model_B.joblib
!models/model_F.joblib
!models/SHA256SUMS
!models/gap_deployed.json

# notebooks checkpoints
.ipynb_checkpoints/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python tooling and builds
*.egg-info/
build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# secrets and local config (never commit)
.env.*
.streamlit/secrets.toml

# JavaScript (app/frontend has its own .gitignore; this covers stray installs)
node_modules/

# logs and local tool state
*.log
.claude/
